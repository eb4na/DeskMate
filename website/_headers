# Cloudflare Pages headers.
# Images: cache a day (they change rarely; version the filename if one changes).
/assets/*
  Cache-Control: public, max-age=86400

# CSS/JS aren't fingerprinted, so always revalidate → edits go live on next deploy.
/*.css
  Cache-Control: public, max-age=0, must-revalidate

/*.js
  Cache-Control: public, max-age=0, must-revalidate

# Pages aren't fingerprinted either. Without this the edge served a STALE page
# for minutes after a deploy — which matters most for /privacy, the URL app-store
# reviewers read. Clean URLs need their own rules; /*.html doesn't match them.
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/privacy
  Cache-Control: public, max-age=0, must-revalidate

/support
  Cache-Control: public, max-age=0, must-revalidate

/delete-account
  Cache-Control: public, max-age=0, must-revalidate
