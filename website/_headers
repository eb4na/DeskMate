# Cloudflare Pages headers.
# Images: cache a day (they change rarely; version the filename if one changes).
/assets/*
  Cache-Control: public, max-age=86400

# CSS/JS aren't fingerprinted, so always revalidate → edits go live on next deploy.
/*.css
  Cache-Control: public, max-age=0, must-revalidate

/*.js
  Cache-Control: public, max-age=0, must-revalidate
