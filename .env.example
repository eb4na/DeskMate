# Expo app (local .env — never commit real keys)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# PostHog product analytics (optional — leave blank to disable). Project token
# from PostHog → Settings → Project. Host: https://us.i.posthog.com (US) or
# https://eu.i.posthog.com (EU). Defaults to US if EXPO_PUBLIC_POSTHOG_HOST unset.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=

# Supabase Edge Function secrets (Dashboard → Edge Functions → Secrets)
# Required:
# OPENAI_API_KEY=
# Local scripts only (e.g. python3 scripts/remove-bg-main-character.py):
# REMOVE_BG_API_KEY=

# Also add REMOVE_BG_API_KEY in Supabase → Edge Functions → Secrets for in-app generation.

# RevenueCat in-app purchases (iOS). Use the Apple SDK key (appl_…) for production
# from RevenueCat → Project Settings → API Keys, or a Test Store key (test_…) for
# sandbox testing. Leave blank to disable purchases (Plus then cannot be bought).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
