@@ -16,8 +16,16 @@ final class AnimatedImage: SDAnimatedImage {
   }
 
   override var duration: TimeInterval {
-    preloadAllFrames()
-    return frames?.reduce(0, { $0 + $1.duration }) ?? 0.0
+    // UIKit's UIImageView reads `duration` on the MAIN thread every time an image is
+    // set (-[UIImageView _setImageViewContents:]). Preloading here decoded every frame
+    // of an animated WebP at full canvas size on the main thread and kept them all
+    // (hundreds of MB per image), which froze the UI and starved SDAnimatedImageView's
+    // frame buffer on device. Sum the per-frame durations from metadata instead;
+    // SDAnimatedImageView plays frames lazily through its own player.
+    if let frames {
+      return frames.reduce(0, { $0 + $1.duration })
+    }
+    return (0..<animatedImageFrameCount).reduce(0.0) { $0 + animatedImageDuration(at: $1) }
   }
 
   // MARK: - SDAnimatedImage
